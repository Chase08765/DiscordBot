# ──────────────────────────────────────────────────────────────────────────────
# 🌍 Runtime
# ──────────────────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development

# ──────────────────────────────────────────────────────────────────────────────
# 🌐 HTTP server
# ──────────────────────────────────────────────────────────────────────────────
PORT=8787
# Bind to loopback only. The extension talks to us over localhost; there is no
# reason to expose this to the network.
HOST=127.0.0.1

# Shared secret the extension must send as `X-Ingest-Key`.
# Leave EMPTY to disable auth (fine for local-only development).
# Must match INGEST_KEY in extension/src/shared/config.js if you set it.
INGEST_KEY=

# Comma-separated origins allowed to POST here.
# chrome-extension://<id> is added automatically for any extension origin.
CORS_ORIGINS=http://localhost:8787

# ──────────────────────────────────────────────────────────────────────────────
# 🗄️  Database
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/discord.db
# WAL is much better for concurrent read-while-writing (stage 2 will query the
# DB while stage 1 is still collecting).
DATABASE_WAL=true

# ──────────────────────────────────────────────────────────────────────────────
# 📜 Logging
# ──────────────────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error
LOG_LEVEL=info
# Emoji prefixes in log output. Turn off for machine-parsed logs.
LOG_EMOJI=true
# Also append logs to ./logs/server-YYYY-MM-DD.log
LOG_TO_FILE=true
LOG_DIR=./logs

# ──────────────────────────────────────────────────────────────────────────────
# 📥 Ingest tuning
# ──────────────────────────────────────────────────────────────────────────────
# Reject batches larger than this many messages (protects against a runaway
# extension flooding the server).
MAX_BATCH_MESSAGES=1000
# Max request body size.
MAX_BODY_SIZE=25mb
# Keep the full Discord JSON for every message. Costs ~3x disk but means we can
# re-derive fields later without re-harvesting. Strongly recommended.
STORE_RAW_JSON=true

# ──────────────────────────────────────────────────────────────────────────────
# 🧠 Claude (stages 2 & 3 — not used yet)
# ──────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5
