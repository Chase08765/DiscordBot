{
  "name": "@discordbot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ingest API + SQLite store for harvested Bittensor Discord data",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/scripts/roles.test.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "db:stats": "tsx src/scripts/stats.ts",
    "db:reclassify": "tsx src/scripts/reclassify.ts",
    "db:reset": "tsx src/scripts/reset.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
